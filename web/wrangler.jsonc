{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "apps-reai-no",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "apps.reai.no",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/app/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "REAI_ORIGIN": "https://app.reai.no"
  }
}
